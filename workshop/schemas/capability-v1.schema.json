{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "twis-capability-v1",
  "title": "TWIS Capability Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilityId", "name", "version", "description", "status", "source", "sourceUrl",
    "license", "lastVerifiedAt", "lastHealthCheckAt", "capabilityType", "inputTypes",
    "outputTypes", "engine", "runtime", "protocol", "adapter", "hardwareRequirements",
    "networkRequirement", "accountRequirement", "credentialRequirement", "costClass",
    "permissions", "authorityLevel", "provenanceSupport", "receiptSupport", "rollbackSupport",
    "healthState", "compatibilityState", "securityNotes", "knownLimitations",
    "replacementGroup", "preferredRank", "tags", "taskKeywords", "verificationPolicyDays", "evidence"
  ],
  "properties": {
    "capabilityId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,99}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "status": {"enum": ["DISCOVERED", "INSPECTING", "TESTING", "VERIFIED", "APPROVED", "DEGRADED", "OFFLINE", "INCOMPATIBLE", "RETIRED", "BLOCKED"]},
    "source": {"type": "string", "minLength": 1},
    "sourceUrl": {"type": "string"},
    "license": {"type": "string", "minLength": 1},
    "lastVerifiedAt": {"type": "string"},
    "lastHealthCheckAt": {"type": "string"},
    "capabilityType": {"enum": ["native", "agent-skill", "local-worker", "disposable-worker", "mcp", "a2a", "wasi-component", "comfy-workflow", "local-model-engine", "browser-engine", "cloud-free-tier", "media-runtime", "external-optional"]},
    "inputTypes": {"type": "array", "items": {"type": "string"}},
    "outputTypes": {"type": "array", "items": {"type": "string"}},
    "engine": {"type": "string"},
    "runtime": {"type": "string"},
    "protocol": {"type": "string"},
    "adapter": {"type": "string"},
    "hardwareRequirements": {"type": "object"},
    "networkRequirement": {"enum": ["none", "optional", "required"]},
    "accountRequirement": {"type": "boolean"},
    "credentialRequirement": {"type": "string"},
    "costClass": {"enum": ["local-free", "open-source-free", "free-tier", "free-with-account", "paid-optional", "paid-required"]},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "writes", "network", "shell", "environment", "credentials", "models", "externalServices"],
      "properties": {
        "reads": {"type": "array", "items": {"type": "string"}},
        "writes": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "array", "items": {"type": "string"}},
        "shell": {"type": "array", "items": {"type": "string"}},
        "environment": {"type": "array", "items": {"type": "string"}},
        "credentials": {"type": "array", "items": {"type": "string"}},
        "models": {"type": "array", "items": {"type": "string"}},
        "externalServices": {"type": "array", "items": {"type": "string"}}
      }
    },
    "authorityLevel": {"enum": ["read-only", "proposal-only", "write-with-approval", "execute-with-approval", "external-submit-with-approval", "blocked"]},
    "provenanceSupport": {"type": "boolean"},
    "receiptSupport": {"type": "boolean"},
    "rollbackSupport": {"type": "boolean"},
    "healthState": {"enum": ["HEALTHY", "DEGRADED", "OFFLINE", "ERROR", "UNKNOWN", "NOT-INSTALLED"]},
    "compatibilityState": {"enum": ["GOOD FIT", "MAY WORK", "TOO HEAVY", "UNSUPPORTED", "UNKNOWN"]},
    "securityNotes": {"type": "string"},
    "knownLimitations": {"type": "string"},
    "replacementGroup": {"type": "string"},
    "preferredRank": {"type": "integer", "minimum": 0},
    "tags": {"type": "array", "items": {"type": "string"}},
    "taskKeywords": {"type": "array", "items": {"type": "string"}},
    "verificationPolicyDays": {"type": "integer", "minimum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}}
    ,"freeTierNotes": {"type": "string"}
    ,"quota": {"type": "string"}
    ,"quotaReset": {"type": "string"}
    ,"currentAvailability": {"type": "string"}
    ,"provider": {"type": "string"}
    ,"fallbackAvailable": {"type": "boolean"}
  }
}
