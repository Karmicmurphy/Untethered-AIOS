{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twis.local/schemas/execution-plan-v0.4.schema.json",
  "title": "Artifact Compass Inspection Execution Plan v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "worker_id", "worker_version", "lifecycle_status",
    "purpose", "initiating_actor", "selected_artifact", "inputs", "outputs",
    "requested_read_root", "canonical_read_roots", "canonical_write_roots", "blocked_roots",
    "requested_permissions", "enforcement", "callable_entry_point", "fixed_command_prefix",
    "timeout_seconds", "max_input_bytes", "max_captured_stream_bytes", "max_output_bytes",
    "expected_file_effects", "expected_output", "required_tests", "recovery_point_plan",
    "worker_card_path", "worker_card_hash", "workspace_generation", "created_at",
    "auto_activate", "plan_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.4"},
    "plan_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "worker_id": {"const": "artifact-compass-inspection-worker"},
    "worker_version": {"const": "0.4.0"},
    "lifecycle_status": {"const": "active"},
    "purpose": {"type": "string", "minLength": 1},
    "initiating_actor": {"type": "string", "minLength": 1, "maxLength": 100},
    "selected_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "project_id", "source_path", "sha256", "file_type", "byte_count", "review_status", "duplicate_hash_group", "provenance_references", "public_read_root"],
      "properties": {
        "artifact_id": {"type": "string"}, "project_id": {"type": "string"},
        "source_path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"},
        "file_type": {"type": "string"}, "byte_count": {"type": "integer", "minimum": 0, "maximum": 524288},
        "review_status": {"type": "string"}, "duplicate_hash_group": {"type": "array", "maxItems": 100},
        "provenance_references": {"type": "array", "maxItems": 100}, "public_read_root": {"type": "string"}
      }
    },
    "inputs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
    "outputs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
    "requested_read_root": {"type": "string", "minLength": 3},
    "canonical_read_roots": {"$ref": "#/$defs/paths"},
    "canonical_write_roots": {"$ref": "#/$defs/paths"},
    "blocked_roots": {"$ref": "#/$defs/paths"},
    "requested_permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["network", "shell", "destructive_actions", "read_only_source", "approval_required"],
      "properties": {
        "network": {"const": false}, "shell": {"const": false}, "destructive_actions": {"const": false},
        "read_only_source": {"const": true}, "approval_required": {"const": true}
      }
    },
    "enforcement": {"type": "object"},
    "callable_entry_point": {"const": "companion.foundation.artifact_inspection_worker"},
    "fixed_command_prefix": {"type": "array", "minItems": 7, "items": {"type": "string"}},
    "timeout_seconds": {"const": 5},
    "max_input_bytes": {"const": 524288},
    "max_captured_stream_bytes": {"const": 16384},
    "max_output_bytes": {"const": 131072},
    "expected_file_effects": {"type": "object"},
    "expected_output": {"type": "object"},
    "required_tests": {"const": ["artifact-inspection-output-v0.4"]},
    "recovery_point_plan": {"type": "object"},
    "worker_card_path": {"type": "string"},
    "worker_card_hash": {"$ref": "#/$defs/sha256"},
    "workspace_generation": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "auto_activate": {"const": false},
    "plan_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "paths": {"type": "array", "items": {"type": "string", "minLength": 3}}
  }
}
