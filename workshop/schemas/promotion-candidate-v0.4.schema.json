{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twis.local/schemas/promotion-candidate-v0.4.schema.json",
  "title": "Artifact Compass Inspection Promotion Candidate v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "candidate_hash", "lifecycle_state", "worker_id",
    "worker_version", "worker_card_path", "worker_card_hash", "plan_id", "plan_path",
    "plan_hash", "transaction_id", "transaction_manifest_path", "receipt_paths",
    "recovery_point", "recovery_point_hash", "workspace_output_path", "candidate_output_path",
    "output_hash", "output", "test_results_path", "test_results", "test_evidence_hash",
    "workspace_generation", "file_effects", "capture", "source_artifact", "approval_binding",
    "approval", "activation", "rollback", "provenance_index", "history", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.4"},
    "candidate_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "candidate_hash": {"$ref": "#/$defs/sha256"},
    "lifecycle_state": {"enum": ["draft", "validated", "execution_planned", "executed", "tests_passed", "candidate", "awaiting_approval", "approved", "rejected", "active", "rolled_back", "revoked", "failed"]},
    "worker_id": {"const": "artifact-compass-inspection-worker"},
    "worker_version": {"const": "0.4.0"},
    "worker_card_path": {"type": "string"}, "worker_card_hash": {"$ref": "#/$defs/sha256"},
    "plan_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "plan_path": {"type": "string"},
    "plan_hash": {"$ref": "#/$defs/sha256"}, "transaction_id": {"type": "string"},
    "transaction_manifest_path": {"type": "string"}, "receipt_paths": {"type": "array", "items": {"type": "string"}},
    "recovery_point": {"type": "object"}, "recovery_point_hash": {"$ref": "#/$defs/sha256"},
    "workspace_output_path": {"type": "string"}, "candidate_output_path": {"type": "string"},
    "output_hash": {"$ref": "#/$defs/sha256"}, "output": {"type": "object"},
    "test_results_path": {"type": "string"}, "test_results": {"type": "array"},
    "test_evidence_hash": {"$ref": "#/$defs/sha256"}, "workspace_generation": {"type": "integer", "minimum": 1},
    "file_effects": {"type": "object"}, "capture": {"type": "object"},
    "source_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "project_id", "source_path", "sha256", "file_type", "review_status"],
      "properties": {
        "artifact_id": {"type": "string"}, "project_id": {"type": "string"}, "source_path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"}, "file_type": {"type": "string"}, "review_status": {"type": "string"}
      }
    },
    "approval_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_hash", "source_artifact_hash", "worker_card_hash", "execution_plan_hash", "workspace_generation"],
      "properties": {
        "candidate_hash": {"$ref": "#/$defs/sha256"}, "source_artifact_hash": {"$ref": "#/$defs/sha256"},
        "worker_card_hash": {"$ref": "#/$defs/sha256"}, "execution_plan_hash": {"$ref": "#/$defs/sha256"},
        "workspace_generation": {"type": "integer", "minimum": 1}
      }
    },
    "approval": {"type": ["object", "null"]}, "activation": {"type": ["object", "null"]},
    "rollback": {"type": ["object", "null"]}, "provenance_index": {"type": "object"},
    "history": {"type": "array"}, "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}
}
