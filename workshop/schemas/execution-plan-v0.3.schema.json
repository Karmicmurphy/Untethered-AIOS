{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twis.local/schemas/execution-plan-v0.3.schema.json",
  "title": "Twis Holo bounded worker execution plan v0.3",
  "description": "Display and evidence contract for the fixed reference worker. Runtime enforcement is implemented in worker_harness.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "plan_hash", "worker_id", "worker_version", "lifecycle_status",
    "purpose", "initiating_actor", "inputs", "outputs", "canonical_read_roots", "canonical_write_roots",
    "blocked_roots", "requested_permissions", "enforcement", "callable_entry_point", "fixed_command_prefix",
    "timeout_seconds", "max_captured_stream_bytes", "max_output_bytes", "expected_file_effects",
    "required_tests", "recovery_point_plan", "worker_card_path", "worker_card_hash", "workspace_generation",
    "created_at", "auto_activate"
  ],
  "properties": {
    "schema_version": {"const": "0.3"},
    "plan_id": {"$ref": "#/$defs/id"},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "worker_id": {"const": "reference-metadata-worker"},
    "worker_version": {"const": "0.1.0"},
    "lifecycle_status": {"const": "test"},
    "purpose": {"type": "string", "minLength": 1},
    "initiating_actor": {"type": "string", "minLength": 1, "maxLength": 100},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
    "outputs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
    "canonical_read_roots": {"$ref": "#/$defs/nonEmptyStrings"},
    "canonical_write_roots": {"$ref": "#/$defs/nonEmptyStrings"},
    "blocked_roots": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requested_permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["network", "shell", "destructive_actions", "approval_required"],
      "properties": {
        "network": {"const": false}, "shell": {"const": false},
        "destructive_actions": {"const": false}, "approval_required": {"const": true}
      }
    },
    "enforcement": {"type": "object"},
    "callable_entry_point": {"const": "companion.foundation.reference_worker"},
    "fixed_command_prefix": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "timeout_seconds": {"const": 5},
    "max_captured_stream_bytes": {"const": 16384},
    "max_output_bytes": {"const": 32768},
    "expected_file_effects": {"type": "object"},
    "required_tests": {"type": "array", "prefixItems": [{"const": "reference-output-v0.1"}], "items": false},
    "recovery_point_plan": {"type": "object"},
    "worker_card_path": {"type": "string", "minLength": 1},
    "worker_card_hash": {"$ref": "#/$defs/hash"},
    "workspace_generation": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "auto_activate": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}

