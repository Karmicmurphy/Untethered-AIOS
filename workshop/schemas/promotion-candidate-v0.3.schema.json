{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twis.local/schemas/promotion-candidate-v0.3.schema.json",
  "title": "Twis Holo guarded promotion candidate v0.3",
  "description": "Evidence record for the fixed harmless reference worker candidate lifecycle.",
  "type": "object",
  "required": [
    "schema_version", "candidate_id", "candidate_hash", "lifecycle_state", "worker_id", "worker_version",
    "worker_card_hash", "plan_id", "plan_hash", "transaction_id", "receipt_paths", "recovery_point",
    "recovery_point_hash", "candidate_output_path", "output_hash", "test_results_path", "test_evidence_hash",
    "workspace_generation", "approval", "activation", "rollback", "history", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.3"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_hash": {"$ref": "#/$defs/hash"},
    "lifecycle_state": {"enum": ["draft", "validated", "execution_planned", "executed", "tests_passed", "candidate", "awaiting_approval", "approved", "rejected", "active", "failed", "rolled_back", "revoked"]},
    "worker_id": {"const": "reference-metadata-worker"},
    "worker_version": {"const": "0.1.0"},
    "worker_card_hash": {"$ref": "#/$defs/hash"},
    "plan_id": {"$ref": "#/$defs/id"},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "transaction_id": {"$ref": "#/$defs/id"},
    "receipt_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "recovery_point": {"type": "object"},
    "recovery_point_hash": {"$ref": "#/$defs/hash"},
    "candidate_output_path": {"type": "string", "minLength": 1},
    "output_hash": {"$ref": "#/$defs/hash"},
    "test_results_path": {"type": "string", "minLength": 1},
    "test_evidence_hash": {"$ref": "#/$defs/hash"},
    "workspace_generation": {"type": "integer", "minimum": 1},
    "approval": {"type": ["object", "null"]},
    "activation": {"type": ["object", "null"]},
    "rollback": {"type": ["object", "null"]},
    "history": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}

