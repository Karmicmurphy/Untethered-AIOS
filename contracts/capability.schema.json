{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untethered AIOS Capability Grant",
  "type": "object",
  "required": [
    "name",
    "scopes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}